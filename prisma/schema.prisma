generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  notes     Note[]
  boardView BoardView?
}

model Note {
  id      String @id @default(uuid())
  x       Float
  y       Float
  content String
  height  Float @default(96)

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model BoardView {
  id    String @id @default(uuid())
  x     Float  @default(0)
  y     Float  @default(0)
  zoom  Float  @default(1)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("board_views")
}
