{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "plugins": ["@stryker-mutator/jest-runner"],
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.mjs"
  },
  "mutate": ["src/hooks/**/*.ts", "src/store/**/*.ts", "!src/**/*.test.ts"],
  "ignorePatterns": [".next", "coverage", "e2e", "reports", "test-results", "playwright-report"],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "concurrency": 2,
  "timeoutMS": 30000
}
